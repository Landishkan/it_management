<Window x:Class="OrderManager.App.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель менеджера | Учёт заказов ПО"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
      Background="{StaticResource WindowBackground}">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Список заказов -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="15" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Заказы" Style="{StaticResource GlassHeader}"/>
                    <ComboBox x:Name="CmbFilterStatus" 
                              SelectedIndex="0"
                              SelectionChanged="CmbFilterStatus_SelectionChanged"
                              Height="32" Margin="0,0,0,10">
                        <ComboBoxItem>Все</ComboBoxItem>
                        <ComboBoxItem>Новый</ComboBoxItem>
                        <ComboBoxItem>В работе</ComboBoxItem>
                        <ComboBoxItem>На проверке</ComboBoxItem>
                        <ComboBoxItem>Завершён</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <ListBox x:Name="LstOrders" Grid.Row="1"
         SelectionChanged="LstOrders_SelectionChanged"
         BorderThickness="0" Style="{StaticResource GlassListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="0,0,0,1">
                                <StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Title}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Foreground="#a8adb6"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                                        <Ellipse Width="7" Height="7" 
         Fill="#E53E3E" 
         Margin="8,0,0,0"
         VerticalAlignment="Center"
         HorizontalAlignment="Left">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ClientName}" 
                               FontSize="11" 
                               Foreground="#718096"
                               Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding StatusDisplay}" 
                                   FontSize="11"
                                   Foreground="#a8adb6"/>
                                        <TextBlock Text="{Binding CreatedAt, 
                            StringFormat='{}{0:dd.MM.yyyy}'}" 
                                   FontSize="11"
                                   Foreground="#a8adb6"
                                   Margin="15,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ: Детали заказа + Задачи -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок заказа -->
                <TextBlock x:Name="TxtOrderTitle" Style="{StaticResource GlassHeader}" Text="Выберите заказ"/>
                <Button Content="Выход" Margin="552,3,0,4" Background="Red" Click="Button_Click"/>
                <!-- Информация о заказе -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <!-- Секция инфо в виде сетки -->
                    <UniformGrid Columns="3" Margin="0,15">
                        <StackPanel>
                            <TextBlock Text="КЛИЕНТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtClient" Text="ИП Иванов А.В." Foreground="{StaticResource TextPrimary}" FontSize="14"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="СТАТУС" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <!-- Можно добавить цветную плашку -->
                            <Border Background="#246abc" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtStatus" Text="В работе" Foreground="White" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="ДАТА СОЗДАНИЯ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtCreated" Text="25.04.2026" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <Border  Background="#F7FAFC" CornerRadius="6"
              Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Описание:" Foreground="#718096" 
                         FontSize="12" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtDescription" 
                        Style="{StaticResource GlassText}" TextWrapping="Wrap"
                         Text="Описание заказа появится здесь"/>
                        </StackPanel>
                    </Border>
                    <!-- Сообщения -->
                    <Expander x:Name="MessagesExpander" 
          Header="💬 Сообщения заказа"
          Foreground="#8AA2C0"
          Margin="0,10,0,0" 
          IsExpanded="False">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDeveloperRevision}" Value="True">
                                        <Setter Property="Header" Value="⚠️ ТРЕБУЕТСЯ ВНИМАНИЕ: Новая доработка!" />
                                        <Setter Property="Foreground" Value="#FF4D4D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>

                  

                    <ListBox x:Name="LstMessages"
   MaxHeight="150"
   BorderThickness="0"
   Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6"
              BorderBrush="#1A4A90E2"
              BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                             Foreground="#4A90E2">
                      <Run Text="{Binding SenderName}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11"
                             Foreground="#5A6D80"
                             Margin="10,0,0,0">
                      <Run Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}"
                         FontSize="13"
                         Foreground="#CCD6E0"
                         TextWrapping="Wrap"
                         Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Expander>
                </StackPanel>
                <!-- Описание -->
              
                <!-- Список задач -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Задачи по заказу" FontSize="15" 
                                   Style="{StaticResource GlassHeader}"/>
                        <Button x:Name="BtnAddTask"
                                Content="+ Создать задачу"
                               Style="{StaticResource GlassActionButton}" 
                                BorderThickness="0"
                                Height="30" Width="140"
                                FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="20,0,0,0"
                                Click="BtnAddTask_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>

                    <ListBox x:Name="LstTasks" Grid.Row="1"
                             BorderThickness="0" Style="{StaticResource GlassListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       Foreground="#a8adb6"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="#718096"
                                                       Margin="0,3,0,0">
                                                <Run Text="Исполнитель:"/>
                                                <Run Text="{Binding DeveloperName}" 
                                                     FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12"
                                                       Foreground="#a8adb6"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="#A0AEC0"
                                                       Margin="0,2,0,0">
                                                <Run Text="Срок:"/>
                                                <Run Text="{Binding Deadline, 
                                                    StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Кнопки действий -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" 
                            Margin="0,15,0,0">
                 
                  
                    <Button x:Name="BtnRevision1"
        Content="На доработку"
        Background="#E53E3E" Foreground="White"
        BorderThickness="0"
        Height="35" Width="140"
        FontSize="13" Cursor="Hand"
     
        Click="BtnRevision_Click"
       />
                    
                    <Button x:Name="BtnRefresh"
                            Content="Обновить"
                            Style="{StaticResource GlassNeutralButton}"
                            BorderThickness="0"
                            Height="35" Width="100"
                            FontSize="13" Cursor="Hand"
                            Margin="10,0,0,0"
                            Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnSaveStatus"
Content="Изменить статус"
Style="{StaticResource GlassActionButton}" 
BorderThickness="0"
Height="35" Width="130"
FontSize="13" Cursor="Hand"
Click="BtnSaveStatus_Click"/>
                    <ComboBox x:Name="CmbOrderSelectionStatus" 
  Width="160" Height="35" 
  VerticalContentAlignment="Center"
  Margin="0,0,10,0">
                        <ComboBoxItem Content="Новый" Tag="New"/>
                        <ComboBoxItem Content="В работе" Tag="InProgress"/>
                        <ComboBoxItem Content="Готов к проверке" Tag="Ready"/>
                        <ComboBoxItem Content="Доработка" Tag="Revision"/>
                        <ComboBoxItem Content="Завершен" Tag="Completed"/>
                    </ComboBox>

                  
                </StackPanel>
               
            </Grid>
        </Border>
    </Grid>
</Window>