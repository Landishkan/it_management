<Window x:Class="OrderManager.App.Views.DeveloperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель разработчика | Учёт заказов ПО"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
       Background="{StaticResource WindowBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Приветствие -->
        <StackPanel>
            <TextBlock Text="Мои задачи" Style="{StaticResource GlassHeader}"/>
            <TextBlock x:Name="TxtDevName"
                       Text="Разработчик: Иван Петров (Backend)"
                       Style="{StaticResource GlassMeta}"/>
        </StackPanel>
        <Button Content="Выход" Margin="728,11,0,13" Background="Red" Click="Button_Click"/>
        <!-- Фильтр по статусу -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0">
            <ComboBox x:Name="CmbStatusFilter"
                      SelectedIndex="0"
                      SelectionChanged="CmbStatusFilter_SelectionChanged"
                      Height="32" Width="180" >
                <ComboBoxItem>Все задачи</ComboBoxItem>
                <ComboBoxItem>Ожидает</ComboBoxItem>
                <ComboBoxItem>В работе</ComboBoxItem>
                <ComboBoxItem>Выполнено</ComboBoxItem>
            </ComboBox>
            <Button Content="Обновить"
                    Style="{StaticResource GlassNeutralButton}"
                   
                    Height="32" Width="100"
                    Cursor="Hand" Margin="10,0,0,0"
                    Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- Список задач -->
        <ListBox x:Name="LstTasks" Grid.Row="2"
                 Margin="0,15,0,0" Style="{StaticResource GlassListBox}"
                 BorderThickness="0"
                 SelectionChanged="LstTasks_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource GlassCard}" Padding="15" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource GlassText}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="#718096" Margin="0,5,0,0">
                        <Run Text="Заказ:"/>
                        <Run Text="{Binding OrderId}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#A0AEC0" Margin="0,3,0,0">
                        <Run Text="Срок:"/>
                        <Run Text="{Binding Deadline, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Messages}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D1A1A" CornerRadius="6" 
                                        Padding="10,8" Margin="0,4,0,0"
                                        BorderBrush="#FF4D4D" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="⚠️ ЗАМЕЧАНИЕ МЕНЕДЖЕРА:" FontSize="11" 
                                                       FontWeight="Bold" Foreground="#FF4D4D"/>
                                                        <TextBlock FontSize="10" Foreground="#A0AEC0" HorizontalAlignment="Right">
                                                <Run Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" 
                                                   Foreground="#CCD6E0" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusDisplay}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#a8adb6" HorizontalAlignment="Center"/>

                                <ComboBox SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              SelectedValuePath="Tag" Width="150" Margin="0,5">
                                    <ComboBoxItem Content="Ожидает" Tag="В ожидании"/>
                                    <ComboBoxItem Content="В работе" Tag="В работе"/>
                                    <ComboBoxItem Content="Выполнено" Tag="Готово"/>
                                </ComboBox>

                                <Button Content="Сохранить" Click="BtnSaveTaskStatus_Click" Tag="{Binding}" Width="150" Margin="0,2"/>

                                <Button Content="На доработку" Background="#E53E3E" Foreground="White"
                            BorderThickness="0" FontSize="11" Cursor="Hand"
                            Height="26" Margin="0,6,0,0" Width="150"
                            Tag="{Binding}" Click="BtnTaskRevision_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>