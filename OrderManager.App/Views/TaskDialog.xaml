<Window x:Class="OrderManager.App.Views.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание задачи" 
        Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
    
       Background="{StaticResource WindowBackground}" Cursor="">

    <Grid Margin="25">
        <Border Style="{StaticResource GlassCard}" Padding="25" Margin="20">
            <StackPanel>
                <TextBlock Text="Новая задача" Style="{StaticResource GlassHeader}"/>

                <!-- Название задачи -->
                <TextBlock Text="Название" Margin="0,0,0,5" Foreground="#a8adb6" FontSize="13"/>
                <TextBox x:Name="TxtTitle" Height="32" FontSize="14"
                     Padding="8,5" BorderBrush="#CBD5E0" Background="#718096" />

                <!-- Разработчик -->
                <TextBlock Text="Исполнитель" Margin="0,15,0,5" Foreground="#a8adb6" FontSize="13"/>
                <ComboBox x:Name="CmbDeveloper" Height="32" FontSize="14"
                      BorderBrush="#CBD5E0" Background="#718096"/>

                <!-- Срок -->
                <TextBlock Text="Срок выполнения" Margin="0,15,0,5" Foreground="#a8adb6" FontSize="13" />
                <DatePicker x:Name="DpDeadline" Height="32" FontSize="14"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                    <Button Content="Отмена" Width="100" Height="34"
                        Background="#A0AEC0" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        Cursor="Hand" Click="BtnCancel_Click"/>
                    <Button Content="Создать" Width="120" Height="34"
                        Background="#417dc4" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        Cursor="Hand" Margin="10,0,0,0"
                        Click="BtnCreate_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>