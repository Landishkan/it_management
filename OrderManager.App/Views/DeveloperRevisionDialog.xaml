<Window x:Class="OrderManager.App.Views.DeveloperRevisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запрос на доработку ТЗ" 
        Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1B2A">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Опишите проблему или вопрос к ТЗ" FontSize="16" FontWeight="Bold" 
                       Foreground="White" Margin="0,0,0,20"/>

            <TextBox x:Name="TxtReason" Height="100" 
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10" FontSize="14"
                     Background="#153050" Foreground="White"
                     CaretBrush="White" BorderThickness="0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="100" Height="34"
                        Background="#3A4A5A" Foreground="#CCD6E0"
                        BorderThickness="0" FontSize="13"
                        Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Отправить" Width="130" Height="34"
                        Background="#E53E3E" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        Cursor="Hand" Margin="10,0,0,0"
                        Click="BtnSend_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>