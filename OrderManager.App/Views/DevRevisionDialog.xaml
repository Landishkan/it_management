<Window x:Class="OrderManager.App.Views.DevRevisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrderManager.App.Views"
        mc:Ignorable="d"
       Title="Формирование правок для разработчика" Height="250" Width="450"
        WindowStartupLocation="CenterOwner" Background="#1A202C" SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🛠 Укажите замечания и инструкции для разработчика:" 
                   Foreground="#8AA2C0" FontSize="14" FontWeight="Medium" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" x:Name="TxtDevReason" 
                 Background="#2D3748" Foreground="White" BorderBrush="#4A5568"
                 TextWrapping="Wrap" AcceptsReturn="True" Padding="8" FontSize="13"
                 VerticalContentAlignment="Top"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Width="90" Height="30" Margin="0,0,10,0" IsCancel="True"
                    Background="#4A5568" Foreground="White" BorderThickness="0"/>
            <Button Content="Передать" Width="100" Height="30" IsDefault="True" Click="BtnSend_Click"
                    Background="#3182CE" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>