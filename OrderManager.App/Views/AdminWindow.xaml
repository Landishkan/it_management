<Window x:Class="OrderManager.App.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D1B2A">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Меню -->
        <Border Background="#1AFFFFFF" CornerRadius="8" Padding="15"
                BorderBrush="#1A4A90E2" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Администрирование" FontSize="18" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,25"/>
                <Button Content="👥 Пользователи" Background="#0056B3" Foreground="White"
                        Height="40" Margin="0,0,0,8" Cursor="Hand" Click="BtnUsers_Click"/>
                <Button Content="📋 Логи" Background="#3A4A5A" Foreground="#CCD6E0"
                        Height="40" Margin="0,0,0,8" Cursor="Hand" Click="BtnLogs_Click"/>
                <Button Content="📊 Статистика" Background="#3A4A5A" Foreground="#CCD6E0"
                        Height="40" Margin="0,0,0,8" Cursor="Hand" Click="BtnStats_Click"/>
                <Button Content="Выйти" Background="#E53E3E" Foreground="White"
                        Height="40" Cursor="Hand" Click="BtnLogout_Click"/>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="8" Padding="20"
                BorderBrush="#1A4A90E2" BorderThickness="1" Margin="10,0,0,0">
            <Grid>
                <!-- Пользователи -->
                <Grid x:Name="PanelUsers" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Пользователи" FontSize="18" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,15"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="+ Создать сотрудника" Background="#2F855A" 
                                Foreground="White" Height="32" Cursor="Hand" 
                                Click="BtnCreateUser_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LstUsers" Grid.Row="2" BorderThickness="0" 
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="#1A4A90E2" 
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                                <Run Text="{Binding FullName}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#8AA2C0" FontSize="11">
                                                <Run Text="{Binding Email}"/>
                                                <Run Text=" • "/>
                                                <Run Text="{Binding Role}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="#E53E3E"
                                                   Visibility="{Binding IsBlocked,Converter={StaticResource BoolToVisibility}}">
                                        
                                        </TextBlock>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                                    VerticalAlignment="Center">

                                            <Button Height="26"
Cursor="Hand"
Click="BtnBlockUser_Click"
Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="Background" Value="#E53E3E"/>
                                                        <!-- красная -->
                                                        <Setter Property="Content" Value="Блокировать"/>

                                                        <Style.Triggers>
                                                            <!-- Если пользователь заблокирован -->
                                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                <Setter Property="Background" Value="#4299E1"/>
                                                                <!-- голубая -->
                                                                <Setter Property="Content" Value="Разблокировать"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Удалить" Background="#3A4A5A" 
                                                    Foreground="#CCD6E0" FontSize="11"
                                                    Height="26" Cursor="Hand" Margin="5,0,0,0"
                                                    Click="BtnDeleteUser_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Логи -->
                <Grid x:Name="PanelLogs" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Журнал действий" FontSize="18" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,15"/>
                    <ListBox x:Name="LstLogs" Grid.Row="1" BorderThickness="0" 
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" BorderBrush="#1A4A90E2" 
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="#4A90E2" FontSize="12" 
                                                       FontWeight="SemiBold">
                                                <Run Text="{Binding UserEmail}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#8AA2C0" FontSize="11" 
                                                       Margin="10,0,0,0">
                                                <Run Text="{Binding Action}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#5A6D80" FontSize="11" 
                                                       Margin="10,0,0,0">
                                                <Run Text="{Binding Timestamp, 
                                                StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Foreground="#CCD6E0" FontSize="12" 
                                                   TextWrapping="Wrap" Margin="0,3,0,0">
                                            <Run Text="{Binding Description}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Статистика -->
                <Grid x:Name="PanelStats" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Статистика" FontSize="18" FontWeight="Bold" 
                                   Foreground="White" Margin="0,0,0,20"/>
                        <TextBlock x:Name="TxtStats" Foreground="#CCD6E0" FontSize="14" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>