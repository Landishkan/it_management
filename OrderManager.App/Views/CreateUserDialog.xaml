<Window x:Class="OrderManager.App.Views.CreateUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать сотрудника" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" 
        Background="#0D1B2A">
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Новый сотрудник" FontSize="16" FontWeight="Bold" 
                       Foreground="White" Margin="0,0,0,20"/>
            <TextBlock Foreground="#8AA2C0" FontSize="12">Имя</TextBlock>
            <TextBox x:Name="TxtName" Height="32" Margin="0,5,0,12"
                     Background="#153050" Foreground="White" CaretBrush="White"/>
            <TextBlock Foreground="#8AA2C0" FontSize="12">Email</TextBlock>
            <TextBox x:Name="TxtEmail" Height="32" Margin="0,5,0,12"
                     Background="#153050" Foreground="White" CaretBrush="White"/>
            <TextBlock Foreground="#8AA2C0" FontSize="12">Пароль</TextBlock>
            <TextBox x:Name="TxtPassword" Height="32" Margin="0,5,0,12"
                     Background="#153050" Foreground="White" CaretBrush="White"/>
            <TextBlock Foreground="#8AA2C0" FontSize="12">Роль</TextBlock>
            <ComboBox x:Name="CmbRole" Height="32" Margin="0,5,0,20"
                      Background="#153050" Foreground="White">
                <ComboBoxItem Content="Менеджер" Tag="Manager" IsSelected="True"/>
                <ComboBoxItem Content="Разработчик" Tag="Developer"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="100" Height="34"
                        Background="#3A4A5A" Foreground="#CCD6E0" Cursor="Hand"
                        Click="BtnCancel_Click"/>
                <Button Content="Создать" Width="120" Height="34" Margin="10,0,0,0"
                        Background="#2F855A" Foreground="White" Cursor="Hand"
                        Click="BtnCreate_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>